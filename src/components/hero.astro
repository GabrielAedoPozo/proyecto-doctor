<script>
	const carousel = document.querySelector<HTMLElement>('#timeline-carousel');

	if (carousel) {
		const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.timeline-slide'));
		const dotsContainer = document.querySelector<HTMLElement>('#timeline-dots');
		const prevButton = document.querySelector<HTMLButtonElement>('#timeline-prev');
		const nextButton = document.querySelector<HTMLButtonElement>('#timeline-next');
		const AUTO_ADVANCE_MS = 5500;

		let current = 0;
		let timer: ReturnType<typeof setInterval> | null = null;

		const dots = slides.map((_, index) => {
			const dot = document.createElement('button');
			dot.type = 'button';
			dot.setAttribute('aria-label', `Ir al hito ${index + 1}`);
			dot.className = 'h-2 w-2 rounded-full bg-white/40 transition-all duration-300';
			dot.addEventListener('click', () => {
				goTo(index);
				restartAuto();
			});
			dotsContainer?.appendChild(dot);
			return dot;
		});

		function render() {
			slides.forEach((slide, index) => {
				slide.classList.toggle('opacity-100', index === current);
				slide.classList.toggle('opacity-0', index !== current);
			});
			dots.forEach((dot, index) => {
				const active = index === current;
				dot.classList.toggle('bg-white', active);
				dot.classList.toggle('w-6', active);
				dot.classList.toggle('bg-white/40', !active);
				dot.classList.toggle('w-2', !active);
			});
		}

		function goTo(index: number) {
			current = (index + slides.length) % slides.length;
			render();
		}

		function next() {
			goTo(current + 1);
		}

		function prev() {
			goTo(current - 1);
		}

		function stopAuto() {
			if (timer) clearInterval(timer);
		}

		function startAuto() {
			stopAuto();
			timer = setInterval(next, AUTO_ADVANCE_MS);
		}

		function restartAuto() {
			startAuto();
		}

		prevButton?.addEventListener('click', () => {
			prev();
			restartAuto();
		});
		nextButton?.addEventListener('click', () => {
			next();
			restartAuto();
		});

		carousel.addEventListener('mouseenter', stopAuto);
		carousel.addEventListener('mouseleave', startAuto);

		render();
		startAuto();
	}
</script>
