<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const stack = document.querySelector<HTMLElement>('.services-stack');

	if (stack) {
		const layers: HTMLElement[] = gsap.utils.toArray('.service-layer', stack);
		const images = layers.map((layer) => layer.querySelector<HTMLElement>('.service-image'));
		const contents = layers.map((layer) => layer.querySelector<HTMLElement>('.service-content'));
		const total = layers.length;

		// How much scroll distance (in viewport heights) each panel gets. Bigger
		// means the slide-up/blur transition plays out more gradually as you scroll
		// instead of snapping between images.
		const VH_PER_PANEL = 2.2;

		// Every layer but the first starts parked just below the viewport.
		gsap.set(layers.slice(1), { yPercent: 100 });
		gsap.set(images, { scale: 1, filter: 'blur(0px)' });
		gsap.set(contents.slice(1), { autoAlpha: 0, y: 40 });

		// One pinned timeline drives the whole sequence: the section locks in place
		// while the user scrolls, and that scroll position scrubs each layer sliding
		// up from the bottom to cover the previous one, which blurs and shrinks
		// away as it gets covered. When the last layer has taken over, the pin
		// releases and normal scrolling continues into the next section.
		const master = gsap.timeline({
			defaults: { ease: 'power2.inOut' },
			scrollTrigger: {
				trigger: stack,
				start: 'top top',
				end: () => `+=${total * window.innerHeight * VH_PER_PANEL}`,
				scrub: 1,
				pin: true,
				anticipatePin: 1,
				invalidateOnRefresh: true,
			},
		});

		layers.forEach((layer, i) => {
			const label = `panel-${i}`;
			master.addLabel(label);

			if (i > 0) {
				master
					.to(contents[i - 1], { autoAlpha: 0, y: -40, duration: 0.5, ease: 'power1.in' }, label)
					.to(images[i - 1], { filter: 'blur(14px)', scale: 0.85, duration: 1.2, ease: 'power1.inOut' }, label)
					.to(layer, { yPercent: 0, duration: 1.2, ease: 'power2.inOut' }, label)
					.to(contents[i], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, `${label}+=0.9`);
			} else {
				master.to(contents[i], { autoAlpha: 1, y: 0, duration: 0.6, ease: 'power2.out' }, label);
			}
		});
	}
</script>

